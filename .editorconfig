root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows 批处理：GBK 编码 + CRLF，请勿用「UTF-8 保存」覆盖
[*.bat]
end_of_line = crlf
insert_final_newline = false
